{
  "name": "mcp-tradebot",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun run server\" \"bun run client\"",
    "server": "bun run backend/server.ts",
    "client": "cd frontend && bun run dev",
    "build": "cd frontend && bun run build",
    "start": "bun run backend/server.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "concurrently": "^8.2.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.3",
    "kiteconnect": "^5.0.1",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1"
  }
}
